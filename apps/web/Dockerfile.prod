# Multi-stage prod build. Relies on `output: 'standalone'` (next.config.ts).
# Next traces the actual files a production boot needs (via @vercel/nft) into
# .next/standalone, including a self-contained node_modules, so the runtime
# stage doesn't run its own `pnpm install` at all, unlike apps/api. Static
# assets and public/ are NOT part of standalone output and must be copied in
# separately (documented Next.js behavior, easy to miss).

FROM node:24-alpine AS build

# This VM sits behind a network proxy, without these, corepack/pnpm can't
# reach the registry during the build. Full reasoning: apps/api/Dockerfile.prod.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy
# Node's native fetch (which corepack uses internally) ignores HTTP_PROXY/
# HTTPS_PROXY entirely unless this is set.
ARG NODE_USE_ENV_PROXY=1

RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/shared packages/shared

# NEXT_PUBLIC_* vars are inlined into the client JS bundle at `next build`
# time, not read from the container's environment later, setting this in
# docker-compose.prod.yml's `environment:` block would silently do nothing here, 
# the build below already ran by the time a container starts.
#
# Empty, not "/v1". Callers already include the full path themselves. 
# Dev's own infra/.env confirms the convention:
# NEXT_PUBLIC_API_URL=http://localhost:3001 there is host-only
# Getting this wrong doubles the prefix into /v1/v1/health, which
# Caddy still routes to api (still starts with /v1/) but Fastify then 404s
# since that route doesn't exist.
ENV NEXT_PUBLIC_API_URL=

# shared must be built first. web imports its compiled dist/, not src/.
RUN pnpm --filter @heritagemonitor/shared build && \
    pnpm --filter @heritagemonitor/web build


FROM node:24-alpine AS runtime

WORKDIR /app

# standalone/ mirrors the monorepo's relative layout internally (it's a
# workspace build), so the real entrypoint lands at apps/web/server.js here.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static apps/web/.next/static
COPY --from=build /app/apps/web/public apps/web/public

WORKDIR /app/apps/web

# Next's standalone server binds localhost-only unless told otherwise — inside
# a container that means nothing outside it (not even Caddy) could connect.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
EXPOSE 3000

CMD ["node", "server.js"]
