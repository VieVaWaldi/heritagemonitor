{
  "name": "@heritagemonitor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "mkdir -p dist/modules/llmchat && cp src/modules/llmchat/SystemPrompt.md dist/modules/llmchat/SystemPrompt.md",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@heritagemonitor/db": "workspace:*",
    "@heritagemonitor/search": "workspace:*",
    "@heritagemonitor/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}