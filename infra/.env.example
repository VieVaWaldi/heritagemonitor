# Rename this file from .env.example to .env and fill in actual vars

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
CACHE_MAX_ENTRIES=1000
# How long the in-memory request-timing ring buffer (apps/api/src/modules/monitoring) keeps data
REQUEST_METRICS_RETENTION_DAYS=14

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=

# --- OpenSearch ---
OPENSEARCH_SECURITY_DISABLED=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_PORT=
OPENSEARCH_HOST=

# --- Meilisearch (dev only, see infra/README.md) ---
MEILI_MASTER_KEY=
MEILISEARCH_PORT=

# --- LLM chat (apps/api/src/modules/llmchat) ---
# Server-to-server auth to OpenRouter — never sent to the browser. Get one at
# https://openrouter.ai. The model(s) used are chosen in code, not here — see
# apps/api/src/modules/llmchat/models.ts.
OPENROUTER_API_KEY=

# --- API <-> Web wiring ---
# Origin(s) the api's CORS policy allows (comma-separated). Defaults to
# http://localhost:3000 if unset. Override for prod (e.g. https://heritagemonitor.org).
CORS_ORIGIN=

# Browser-visible base URL the web app polls directly.
# Must be reachable from the browser, not just from inside the Docker network
# That's why it's localhost:3001, not the internal service name `api`.
NEXT_PUBLIC_API_URL=
