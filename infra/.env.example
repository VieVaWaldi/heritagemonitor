# Rename this file from .env.example to .env and fill in actual vars

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
CACHE_MAX_ENTRIES=1000
# How long the in-memory request-timing ring buffer (apps/api/src/modules/monitoring) keeps data
REQUEST_METRICS_RETENTION_DAYS=14

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=

# --- OpenSearch ---
OPENSEARCH_SECURITY_DISABLED=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_PORT=
OPENSEARCH_HOST=

# --- LLM chat (apps/api/src/modules/llmchat) ---
# Server-to-server auth to OpenRouter — never sent to the browser. Get one at
# https://openrouter.ai. The model(s) used are chosen in code, not here — see
# apps/api/src/modules/llmchat/models.ts.
OPENROUTER_API_KEY=

# --- Exports (apps/api/src/modules/exports) ---
# Where generated CSV/JSON export files + their in-progress temp files are
# written inside the api container; must match the volume mount path.
EXPORT_DIR=/data/exports
# How many /search download requests the api will actively stream/scan from
# OpenSearch at once; extra requests wait briefly rather than being rejected outright.
EXPORT_MAX_CONCURRENCY=4
# How long a request will wait for a free concurrency slot before the api
# gives up and returns a "try again" error.
EXPORT_MAX_QUEUE_WAIT_MS=30000
# How long a completed export file is kept on disk (and reusable as a cache
# hit for an identical repeat request) before an hourly sweep deletes it.
EXPORT_RETENTION_HOURS=24
# Total disk budget for all export files combined; the sweep deletes the
# oldest ones first if this is exceeded, as a backstop on top of time-based retention.
EXPORT_STORAGE_CAP_BYTES=20000000000

# --- API <-> Web wiring ---
# Origin(s) the api's CORS policy allows (comma-separated). Defaults to
# http://localhost:3000 if unset. Override for prod (e.g. https://heritagemonitor.org).
CORS_ORIGIN=

# Browser-visible base URL the web app polls directly.
# Must be reachable from the browser, not just from inside the Docker network
# That's why it's localhost:3001, not the internal service name `api`.
NEXT_PUBLIC_API_URL=
# Public (pk.) Mapbox token for apps/web/src/common/deckgl's basemap. Get one at
# https://account.mapbox.com/access-tokens — public tokens are meant to ship to the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
