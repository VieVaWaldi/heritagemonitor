# Compiles every pure-TS workspace package (shared, db, search) that apps/api
# and apps/web import via compiled dist/ output rather than raw src/.
# One container, three `tsc --watch` processes (infra/build-libs.sh),
# so api/web depend on a single healthcheck.

# Build context is the monorepo root (see docker-compose.yml) so pnpm can see
# the workspace root manifests, same reasoning as apps/api's Dockerfile.

FROM node:24-alpine

# Needed when built on a proxy-restricted network (prod VM).
# Harmless elsewhere (e.g. a laptop with unrestricted internet).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy
# Node's native fetch (which corepack uses internally) ignores HTTP_PROXY/
# HTTPS_PROXY entirely unless this is set.
ARG NODE_USE_ENV_PROXY=1

RUN corepack enable && corepack prepare pnpm@10 --activate

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/search/package.json packages/search/package.json
RUN pnpm install

COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/search packages/search
COPY infra/build-libs.sh build-libs.sh
RUN chmod +x build-libs.sh

CMD ["./build-libs.sh"]
